(text "Modo paralelo (TI DRV8833, fig. 7). Ponte espelhada: ME_IN1->IN2/IN4 e M+ <- OUT2/OUT4 (mesmo sentido de giro; facilita a placa)." (exclude_from_sim no) (at 179.07 228.6 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "03ac623e-3716-5d41-bd45-c141b447abe1"))
(text "C2/C3 junto ao VCC de cada modulo. Abrir o jumper J2 do modulo se ligar EEP a VCC." (exclude_from_sim no) (at 179.07 231.14 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "c742adb6-bebe-51f5-94ac-50fe68b8230d"))
(text "COMO LER: blocos ligados por fios; rotulos iguais (ex.: ENC_E_A_5V, DRV_SLEEP, VBAT_ADC) sao o mesmo fio." (exclude_from_sim no) (at 20.32 245.0 0) (effects (font (size 1.2 1.2) (bold yes)) (justify left top)) (uuid "a0cadaeb-feb6-57be-bbbf-6f94e57779bf"))
(text "Pinos = firmware/robocar_esp32/config.h. Encoder alimentado em 5 V; a ESP32 so recebe 0-3,3 V (CD4050B)." (exclude_from_sim no) (at 20.32 249.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "c39e4280-b895-57ed-9508-abd5bb15f6b2"))
(text "Conector do motor na ordem RoboCore: 1 M+, 2 M-, 3 A, 4 B, 5 Vcc, 6 GND (usar o numero do pino, nao a cor)." (exclude_from_sim no) (at 20.32 253.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "9b0f682c-e733-5bcc-bf41-91b0c06d6fe9"))
